# ───────── Core ─────────
NODE_ENV=development
APP_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgresql://familyfinance:familyfinance@localhost:5432/familyfinance?schema=public
# Long random string (>=32 chars). Used to sign short-lived tokens (OAuth state, signed download links). Generate: openssl rand -base64 48
AUTH_SECRET=change-me-generate-a-long-random-string-at-least-32-chars
# Require verified email before login (true recommended in production)
REQUIRE_EMAIL_VERIFICATION=true

# ───────── Email (optional; without SMTP, mail is written to the EmailOutbox table + server log) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Family Finance Hub <no-reply@example.com>"

# ───────── Google sign-in (optional) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── File storage ─────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=10
# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2...)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ───────── Background jobs ─────────
# Shared secret for POST /api/cron/run (for platform schedulers). Generate: openssl rand -hex 32
CRON_SECRET=
# Run the job scheduler inside the web process (ok for single-instance deploys). Otherwise run `npm run worker`.
ENABLE_INPROCESS_JOBS=false

# ───────── Web push (optional) - generate with: npx web-push generate-vapid-keys ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ───────── Optional integrations ─────────
# AI assistant (falls back to deterministic assistant when unset)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# VIN decoding: nhtsa (public, no key) | none
VIN_DECODER=nhtsa
# Receipt OCR: none | anthropic (uses ANTHROPIC_API_KEY) | text (local text-layer PDF heuristics)
OCR_PROVIDER=text

# ───────── Plans / entitlements ─────────
# disabled = every feature unlocked (self-hosted default). enforced = plan limits applied.
BILLING_MODE=disabled
DEFAULT_PLAN=FREE

# ───────── Observability ─────────
LOG_LEVEL=info
# Error monitoring hook (e.g. Sentry DSN); consumed by src/lib/monitoring.ts
ERROR_MONITORING_DSN=
RATE_LIMIT_STORE=memory
