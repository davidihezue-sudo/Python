# EAZyfoods configuration. Copy to .env and edit. Nothing here is required for local development.
# Real credentials must never be committed. Integrations stay in "dev" or "sandbox" mode until their keys are set.

# ---- core ----
NODE_ENV=development
DATABASE_URL=postgres://postgres@127.0.0.1:5544/eazyfoods
# Separate database used only by the automated tests (it is wiped on every run)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5544/eazyfoods_test
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Public address of the web app, and the origins allowed to call the API with cookies
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to the parent domain (for example .eazyfoods.ca) to share the session cookie between vendor., chef., driver. and admin. hosts
COOKIE_DOMAIN=
SECURE_COOKIES=false
SESSION_TTL_DAYS=30

# Password given to every seeded demo account. Never run the seed against a production database.
DEMO_PASSWORD=EazyDemo!2026
# The seed refuses to run when NODE_ENV=production unless this is true (staging and demo deployments only)
ALLOW_DEMO_SEED=false

# ---- web app (apps/web) ----
# Where the Next.js server reaches the API (server side and rewrites)
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: connect the browser straight to the API for server sent events instead of going through the web proxy
NEXT_PUBLIC_STREAM_URL=

# ---- payments ----
# sandbox accepts test tokens only and moves no money. stripe requires STRIPE_SECRET_KEY.
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- messages ----
# dev records every email, SMS and push in the message_outbox table instead of sending it
EMAIL_PROVIDER=dev
EMAIL_FROM=EAZyfoods <no-reply@eazyfoods.ca>
SENDGRID_API_KEY=
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUSH_PROVIDER=dev
FIREBASE_SERVER_KEY=

# ---- maps and geocoding ----
# local uses a built in table of Canadian postal prefixes and cities. google or mapbox need a key.
MAPS_PROVIDER=local
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# ---- file storage ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=
STORAGE_PUBLIC_BASE=/api/files
UPLOAD_MAX_BYTES=8388608

# ---- optional ----
ANALYTICS_PROVIDER=internal
AI_PROVIDER=none
ANTHROPIC_API_KEY=
