  lines           Json
  active          Boolean   @default(true)
  lastRunOn       DateTime? @db.Date
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, ownerMemberId])
}

/// Contribution room at the start of a year for one person and one registered plan, as entered from their CRA notice. Private to that person.
model RegisteredRoom {
  id          String         @id @default(cuid())
  householdId String
  memberId    String
  kind        InvestmentKind
  year        Int
  openingRoom Decimal        @db.Decimal(14, 2)
  note        String?
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([memberId, kind, year])
  @@index([householdId])
}
