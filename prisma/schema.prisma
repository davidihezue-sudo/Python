// ───────────────────────── Rules, saved views, pay day plans, registered account room ─────────────────────────

enum RuleScope {
  MINE
  HOUSEHOLD
}

/// "If the description contains X (and the amount is between...), then set the category / vehicle / tags." Applied when a transaction is created or imported.
/// MINE rules apply to the transactions their owner enters; HOUSEHOLD rules (administrators only) apply to everyone's.
model FinRule {
  id            String    @id @default(cuid())
  householdId   String
  ownerMemberId String
  scope         RuleScope @default(MINE)
  name          String
  priority      Int       @default(100)
  active        Boolean   @default(true)
  conditions    Json
  actions       Json
  hitCount      Int       @default(0)
  lastHitAt     DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, active])
}

/// A member's own saved filter or report setup. Private to that member.
model SavedView {
  id          String   @id @default(cuid())
