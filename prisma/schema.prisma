// AutoVault database schema.
// Conventions:
//  * All odometer values are stored in KILOMETRES (Decimal(10,1)); conversion to miles happens at the UI/report boundary.
//  * All money is Decimal(12,2) with an explicit currency column.
//  * Calendar dates (service date, due date…) use @db.Date; instants use timestamptz.
//  * Soft deletion (deletedAt) is used on user-authored records so history/audit survives.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

